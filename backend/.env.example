# --- Hindsight ---
# Cloud (default): https://api.hindsight.vectorize.io  (use your Hindsight Cloud API key)
# Local Docker:    http://localhost:8888                (leave HINDSIGHT_API_KEY blank)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=secops-memory-org1

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
